# Copia in /mnt/etc/nixos/secrets/wifi.env durante l'installazione e
# mettilo solo-root:
#   mkdir -p /mnt/etc/nixos/secrets
#   cp wifi.env.example /mnt/etc/nixos/secrets/wifi.env
#   nano /mnt/etc/nixos/secrets/wifi.env
#   chmod 700 /mnt/etc/nixos/secrets && chmod 600 /mnt/etc/nixos/secrets/wifi.env
WIFI_SSID="NomeDellaRete"
WIFI_PSK="LaPasswordDelWiFi"
